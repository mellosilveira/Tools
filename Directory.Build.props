<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<!-- Product information (common to every package in the solution). -->
		<Authors>MelloSilveira</Authors>
		<Company>MelloSilveira</Company>
		<Product>MelloSilveira Tools</Product>
		<Copyright>MelloSilveira - Copyright © 2025</Copyright>
		<NeutralLanguage>en-us</NeutralLanguage>

		<!-- Repository / license (common). -->
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/mellosilveira/Tools</RepositoryUrl>
		<PackageProjectUrl>https://github.com/mellosilveira/Tools</PackageProjectUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

		<!-- Versioning (common). -->
		<VersionPrefix>1.5.0-rc007</VersionPrefix>
		<PackageReleaseNotes>See CHANGELOG.md for the full list of changes.</PackageReleaseNotes>

		<!-- Setup initial variables if not defined. -->
		<Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
		<Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
		<ProjectRootDir Condition=" '$(ProjectRootDir)' == '' ">$(MSBuildThisFileDirectory)</ProjectRootDir>
		<NuGetPackagesRootDir Condition=" '$(NuGetPackagesRootDir)' == '' ">$(UserProfile)\.nuget\packages\</NuGetPackagesRootDir>

		<!-- Path definitions. -->
		<BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)\build\tmp\$(MSBuildProjectName)</BaseIntermediateOutputPath>
		<IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>
		<OutputPath>$(MSBuildThisFileDirectory)\build\bin\$(Configuration)\$(MSBuildProjectName)</OutputPath>

		<!-- Variable and compile-time constant for the framework. -->
		<FrameworkIdentifier>$(TargetFramework.TrimEnd('.0123456789'))</FrameworkIdentifier>
		<DefineConstants>$(DefineConstants);$(FrameworkIdentifier.ToUpper())</DefineConstants>
		<TargetFramework>net10.0</TargetFramework>

		<!-- Compiler / language behavior (common). -->
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Packaging / documentation behavior (common). -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- Suppress CS1591 on generated resources and other deliberately undocumented internals,
		     plus the trim/AOT diagnostic warnings — we keep [DynamicallyAccessedMembers] where it
		     matters but don't propagate [RequiresUnreferencedCode]/[RequiresDynamicCode] noise. -->
		<NoWarn>$(NoWarn);CS1591;IL2026;IL2046;IL2050;IL2067;IL2070;IL2072;IL2075;IL2077;IL2080;IL2087;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2111;IL3000;IL3050;IL3051;IL3052</NoWarn>
	</PropertyGroup>

	<!-- Deterministic build on CI. -->
	<PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == '' and '$(CI)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DocumentationFile>..\$(MSBuildProjectName)\$(MSBuildProjectName).xml</DocumentationFile>
	</PropertyGroup>

	<!-- README, CHANGELOG and LICENSE are packed into every NuGet produced from this repository. -->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
