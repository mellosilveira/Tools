<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MelloSilveiraTools.Plugins</PackageId>
    <AssemblyTitle>MelloSilveira Tools Plugins</AssemblyTitle>
    <Description>Plugin runtime: file-based discovery, two-level cache, dynamic DI, persistence (file/database), HTTP-friendly operations and a background orchestrator that hot-swaps assemblies at runtime.</Description>
    <PackageTags>dotnet;aspnetcore;plugins;hot-reload;dynamic-di;background-service</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MelloSilveiraTools.WebApi\MelloSilveiraTools.WebApi.csproj" />
  </ItemGroup>
</Project>
