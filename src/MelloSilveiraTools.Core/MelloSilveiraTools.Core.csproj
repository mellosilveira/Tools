<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<PackageId>MelloSilveiraTools.Core</PackageId>
		<AssemblyTitle>MelloSilveira Tools Core</AssemblyTitle>
		<Description>Core helpers for .NET: extension methods, file logger, in-memory caches, Polly resilience pipelines, encryption, SMTP email and numerical methods (Newmark / Newmark-β).</Description>
		<PackageTags>dotnet;extensions;logger;cache;polly;resilience;encryption;email;numerical-methods</PackageTags>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="AWSSDK.S3" Version="4.0.104.4" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
		<PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
		<PackageReference Include="Polly" Version="8.7.0" />
		<PackageReference Include="Polly.RateLimiting" Version="8.7.0" />
		<PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Sinks.Postgresql.Alternative" Version="4.3.0" />
	</ItemGroup>
</Project>
