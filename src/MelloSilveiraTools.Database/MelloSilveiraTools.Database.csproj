<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MelloSilveiraTools.Database</PackageId>
    <AssemblyTitle>MelloSilveira Tools Database</AssemblyTitle>
    <Description>PostgreSQL repository with attribute-driven SQL generation, filter clauses, Npgsql/Dapper extensions and a dedicated Polly resilience pipeline.</Description>
    <PackageTags>dotnet;postgres;npgsql;dapper;repository;sql;polly</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MelloSilveiraTools.Core\MelloSilveiraTools.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog.Sinks.Postgresql.Alternative" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="RelationalDatabase\Sql\Provider\SqlResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SqlResource.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="RelationalDatabase\Sql\Provider\SqlResource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>SqlResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
