<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<PackageId>MelloSilveiraTools.Mathematics</PackageId>
		<AssemblyTitle>MelloSilveira Tools - Mathematics</AssemblyTitle>
		<Description>Mathematics toolkit: differential equation solvers (Newmark, Newmark-β), expressions, functions, derivatives, integrals and supporting numerical primitives.</Description>
		<PackageTags>dotnet;mathematics;numerical-methods;newmark;differential-equations;expressions;functions;engineering;math</PackageTags>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\MelloSilveiraTools.Core\MelloSilveiraTools.Core.csproj" />
	</ItemGroup>

</Project>
