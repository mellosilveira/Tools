<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<PackageId>MelloSilveiraTools.MechanicsOfMaterials.Optimizations</PackageId>
		<AssemblyTitle>MelloSilveira Tools - Mechanics of Materials - Optimizations</AssemblyTitle>
		<Description>Mechanics of Materials optimization toolkit: experimental data processing, continuous stream segmentation, constitutive model curve fitting (MathNet.Numerics and ALGLIB), TPL Dataflow pipelines, and parametric sweep sensitivity analysis.</Description>
		<PackageTags>mechanics-of-materials;optimizations;curve-fitting;alglib;mathnet;constitutive-models;dataflow;segmentation;sensitivity-analysis;dotnet</PackageTags>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>UnitTests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MathNet.Numerics" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MelloSilveiraTools.MechanicsOfMaterials\MelloSilveiraTools.MechanicsOfMaterials.csproj" />
		<ProjectReference Include="..\MelloSilveiraTools.Database\MelloSilveiraTools.Database.csproj" />
	</ItemGroup>

</Project>


