<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
    </Found>
    <NotFound>
        <div class="container">
            <div class="card">
                <h2>Page Not Found</h2>
                <p>The requested view was not found.</p>
            </div>
        </div>
    </NotFound>
</Router>
