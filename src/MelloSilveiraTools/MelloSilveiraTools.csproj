<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MelloSilveiraTools</PackageId>
    <AssemblyTitle>MelloSilveira Tools</AssemblyTitle>
    <Description>Meta-package that brings in every MelloSilveiraTools feature (Core, Database, WebApi, Plugins, Mathematics, MechanicsOfMaterials). Install only the contextual packages if you do not need everything.</Description>
    <PackageTags>dotnet;aspnetcore;plugins;postgres;npgsql;jwt;jwe;resilience;polly;swagger;crud;repository;dapper;cache;mathematics;mechanics-of-materials;meta-package</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MelloSilveiraTools.Core\MelloSilveiraTools.Core.csproj" />
    <ProjectReference Include="..\MelloSilveiraTools.Database\MelloSilveiraTools.Database.csproj" />
    <ProjectReference Include="..\MelloSilveiraTools.Mathematics\MelloSilveiraTools.Mathematics.csproj" />
    <ProjectReference Include="..\MelloSilveiraTools.MechanicsOfMaterials.Optimizations\MelloSilveiraTools.MechanicsOfMaterials.Optimizations.csproj" />
    <ProjectReference Include="..\MelloSilveiraTools.MechanicsOfMaterials\MelloSilveiraTools.MechanicsOfMaterials.csproj" />
    <ProjectReference Include="..\MelloSilveiraTools.Plugins\MelloSilveiraTools.Plugins.csproj" />
    <ProjectReference Include="..\MelloSilveiraTools.WebApi\MelloSilveiraTools.WebApi.csproj" />
  </ItemGroup>
</Project>
