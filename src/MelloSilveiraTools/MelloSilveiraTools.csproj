<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>MelloSilveiraTools</PackageId>
		<AssemblyTitle>MelloSilveira Tools</AssemblyTitle>
		<Description>Helpers for .NET system development: plugin runtime, PostgreSQL repository with attribute-driven SQL, two-level cache, JWE authentication, resilience pipelines (Polly), CRUD controllers and use-case operations, Swagger bootstrap, file logger and string/type/form-file extensions.</Description>
		<PackageTags>dotnet;aspnetcore;plugins;postgres;npgsql;jwt;jwe;resilience;polly;swagger;crud;repository;dapper;cache</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.72" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
		<PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.17.0" />
		<PackageReference Include="Npgsql" Version="10.0.2" />
		<PackageReference Include="Polly" Version="8.6.6" />
		<PackageReference Include="Polly.RateLimiting" Version="8.6.6" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
		<PackageReference Include="Swashbuckle.AspNetCore.Newtonsoft" Version="10.1.7" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Infrastructure\Database\Sql\Provider\SqlResource.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>SqlResource.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Infrastructure\Database\Sql\Provider\SqlResource.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>SqlResource.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
