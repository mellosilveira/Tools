{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "AddMechanicalModels": true,
  "UploadSampleDatasetsOnStartup": true,
  "AllowedCorsOrigins": [
    "http://localhost:5080",
    "http://localhost:24263"
  ],
  "DefaultResiliencePipeline": {
    "BackoffType": "Exponential",
    "DelayInMilliseconds": 200,
    "MaxRetryAttempts": 3,
    "UseJitter": true
  },
  "Database": {
    "ConnectionString": "",
    "UnitOperationTimeoutInMilliseconds": 30000,
    "BulkOperationTimeoutInMilliseconds": 120000,
    "AllowSuperuserDatabaseConnection": false
  },
  "Encryption": {
    "SaltSize": 16,
    "HashSize": 32,
    "Iterations": 100000
  },
  "FileStorage": {
    "DefaultStorageProvider": "Local",
    "Local": {
      "BaseDirectory": "~/MelloSilveiraTools/storage"
    }
  },
  "Plugins": {
    "StorageProvider": "Local",
    "Directory": "plugins",
    "PollInterval": "00:05:00",
    "PreviousVersionRetention": "24:00:00",
    "DefaultCacheTarget": "file",
    "MaxPluginSizeBytes": 10485760,
    "AllowUnmanagedDlls": false,
    "MaxPendingSubmissionsPerUser": 5
  },
  "CurveFitter": {
    "Seed": 42,
    "DefaultCurveFitter": "Alglib"
  },
  "ExperimentalData": {
    "SegmenterOptions": {
      "MaxWorkers": 1,
      "MaxBufferSize": 256,
      "KeepOrder": true
    },
    "FileWriterOptions": {
      "MaxWorkers": 1,
      "MaxBufferSize": 256,
      "KeepOrder": true
    },
    "PersistanceOptions": {
      "MaxWorkers": 1,
      "MaxBufferSize": 256,
      "KeepOrder": true
    },
    "SegmentBuilderOptions": {
      "MaxWorkers": 1,
      "MaxBufferSize": 256,
      "KeepOrder": true
    },
    "CurveFitterOptions": {
      "MaxWorkers": 1,
      "MaxBufferSize": 256,
      "KeepOrder": true
    },
    "SimulationInputBuilderOptions": {
      "MaxWorkers": 1,
      "MaxBufferSize": 256,
      "KeepOrder": true
    },
    "IngestionBufferCapacity": 256,
    "MaxCsvSizeBytes": 52428800
  },
  "ParametricSweep": {
    "IngestionBufferCapacity": 256
  },
  "PipelineProgressNotifier": {
    "ChannelCapacity": 512,
    "FullMode": "DropOldest",
    "MaxChannels": 64
  },
  "Jwt": {
    "Issuer": "MelloSilveiraTools.WebApi.Host",
    "Audience": "MelloSilveiraTools.WebUi",
    "EncryptionKey": "",
    "SigningKey": "",
    "ClockSkewInSeconds": 30,
    "SecurityKeyType": "Symmetric",
    "TokenExperitationTimeInMinutes": 120
  },
  "Superuser": {
    "Username": "admin",
    "Password": ""
  }
}
